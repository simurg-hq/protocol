{
  "description": "A start ping opens a run and returns its ID in the body and the Run-Id header.",
  "known_monitors": [
    {
      "token": "abcdefghijklmnopqrstuvwxyz"
    }
  ],
  "request": {
    "method": "GET",
    "path": "/ping/abcdefghijklmnopqrstuvwxyz/start",
    "headers": {
      "User-Agent": "curl/8.10.1"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "text/plain; charset=utf-8",
      "Run-Id": "$any"
    },
    "body": "$any"
  },
  "event": {
    "v": 1,
    "id": "$any",
    "kind": "start",
    "received_at": "$any",
    "monitor": {
      "token": "abcdefghijklmnopqrstuvwxyz"
    },
    "run_id": "$any",
    "exit_code": null,
    "unverified": false,
    "source": "http",
    "idempotency_key": null,
    "metrics": {},
    "metrics_rejected": [],
    "output": null,
    "output_truncated": false
  }
}
